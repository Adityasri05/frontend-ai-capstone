# CineTrack Movie Watchlist Environment Configuration
# Copy this file to .env.local and configure your keys for local development.

# OMDb API Key
# Sign up at https://www.omdbapi.com/ to get your own API key.
# CineTrack includes a fallback key ("849d44e5") to run in demo mode out-of-the-box.
NEXT_PUBLIC_OMDB_API_KEY=

# Firebase Configuration
# Configure these to synchronize watchlist items to the cloud.
# If left blank, CineTrack will run in Local Mode using localStorage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anthropic Claude API Configuration (Server-Side Secret Only)
# Used for HIREVIUM AI Technical Qualification Interview streaming.
# NEVER prefix with NEXT_PUBLIC_ to prevent client-side exposure.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

